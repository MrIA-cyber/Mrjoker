{
  "entities": {
    "users": {
      "title": "users",
      "description": "User profiles and settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["id"]
    },
    "products": {
      "title": "products",
      "description": "Product catalog items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" }
      },
      "required": ["id", "name", "price"]
    },
    "orders": {
      "title": "orders",
      "description": "Customer order records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id"]
    },
    "chats": {
      "title": "chats",
      "description": "Real-time conversation threads between customers and sellers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "merchantId": { "type": "string" },
        "merchantName": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string" },
        "unreadCountClient": { "type": "number" },
        "unreadCountMerchant": { "type": "number" }
      },
      "required": ["id", "clientId", "merchantId"]
    },
    "merchant_stats": {
      "title": "merchant_stats",
      "description": "Cached dashboard statistics for merchants",
      "type": "object",
      "properties": {
        "merchantId": { "type": "string" },
        "totalRevenue": { "type": "number" },
        "todaySales": { "type": "number" },
        "monthlySales": { "type": "number" },
        "pendingOrdersCount": { "type": "number" },
        "totalStockCount": { "type": "number" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["merchantId"]
    }
  },
  "securityRules": {
    "match /users/{userId}": {
      "allow read, write": "true"
    },
    "match /products/{productId}": {
      "allow read, write": "true"
    },
    "match /orders/{orderId}": {
      "allow read, write": "true"
    },
    "match /chats/{chatId}": {
      "allow read, write": "true"
    },
    "match /chats/{chatId}/messages/{messageId}": {
      "allow read, write": "true"
    },
    "match /merchant_stats/{merchantId}": {
      "allow read, write": "true"
    }
  }
}
